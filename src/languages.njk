---
title: Languages
layout: base.njk
pageClass: ik-layouts
script: languages.js
permalink: /languages.html
description: Every language in Indic Keyboard and its keyboard layouts, with where each layout comes from.
---
{% set stats = home.stats %}
<section class="ik-layouts__intro">
  <div>
    <nav aria-label="Breadcrumb" class="ik-crumbs"><a href="/">Home</a> / Languages</nav>
    <h1>Languages</h1>
    <p>Every language in Indic Keyboard and its layouts. Open a layout to see its keys or how English letters turn into your script, and where it comes from.</p>
  </div>
  <div class="ik-layouts__stats">
    <div><strong>{{ stats.languages }}</strong><span>languages</span></div>
    <div><strong>{{ stats.layouts }}</strong><span>layouts</span></div>
    <div><strong>{{ stats.scripts }}</strong><span>scripts</span></div>
  </div>
</section>

<div class="ik-layouts__controls" data-layouts-controls hidden>
  <div class="lang-explorer__filters" role="group" aria-label="Filter by layout type">
    {% for f in ['All', 'Inscript', 'Phonetic', 'Transliteration', 'Predictive', 'Compact', 'Other'] %}
    <button type="button" data-type-filter="{{ f }}" aria-pressed="{{ 'true' if loop.first else 'false' }}"{% if loop.first %} class="is-on"{% endif %}>{{ 'All types' if f == 'All' else f }}</button>
    {% endfor %}
  </div>
  <label class="lang-explorer__search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
    <span class="visually-hidden">Search layouts</span>
    <input type="search" placeholder="Search languages, scripts or layouts" data-layouts-search>
  </label>
</div>

<div class="ik-langs">
  <table class="ik-langs__table">
    <thead>
      <tr><th scope="col">Language</th><th scope="col">Layouts</th></tr>
    </thead>
    <tbody>
      {% for l in layouts.languages %}
      <tr id="{{ l.code }}" data-layout-group>
        <th scope="row">
          <span class="ik-langs__native" lang="{{ l.code }}" dir="{{ l.dir }}">{{ l.native }}</span>
          <span class="ik-langs__name">{{ l.name }}{% if l.isNew %} <span class="badge">New</span>{% endif %}</span>
          {% if l.scripts.length > 1 %}<span class="ik-langs__scripts">{{ l.scripts | join(', ') }}</span>{% endif %}
        </th>
        <td>
          <ul class="ik-layout-pills">
            {% for x in l.layouts %}
            <li data-layout-row data-type="{{ x.type }}" data-search="{{ (x.name + ' ' + x.type + ' ' + l.name + ' ' + l.native + ' ' + (l.scripts | join(' '))) | lower }}">
              <a href="{{ x.url }}" title="{{ x.type }}">{{ x.name }}{% if x.isNew %}<span class="ik-layout-pills__new">New</span>{% endif %}</a>
            </li>
            {% endfor %}
          </ul>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="lang-explorer__empty" data-layouts-empty hidden>No layout matches. <a href="{{ links.issues }}">Ask for the one you need.</a></p>
</div>
